# DriftLogg backend environment variables
# 1. Copy this file to server/.env   (PowerShell: Copy-Item .env.example .env)
# 2. Replace the MONGO_URI line below with your own MongoDB Atlas connection string.
# Never commit server/.env to GitHub.

# MongoDB connection string (Atlas). Keep "/driftlogg" before the "?".
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/driftlogg?retryWrites=true&w=majority

# Local MongoDB alternative (comment out the Atlas line above and use this instead):
# MONGO_URI=mongodb://127.0.0.1:27017/driftlogg

# Port of the backend API. The React app calls http://localhost:5000/api by default.
PORT=5000

# Frontend URL(s) allowed by CORS, comma separated. Must be exact (no trailing slash).
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens (JWT). Use a long random value and keep it private.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If empty, a development-only default is used. The server refuses to start in production without it.
JWT_SECRET=

# development or production
NODE_ENV=development
